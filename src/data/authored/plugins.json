{
  "title": "RuneLite plugins",
  "intro": [
    {
      "t": "p",
      "text": "Built-in plugins are enabled in the settings (the wrench icon), and Plugin Hub plugins are installed in the same place with the \"Plugin Hub\" button. Start with the first table and add the rest as needed."
    }
  ],
  "groups": [
