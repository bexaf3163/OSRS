          "source": "hub",
          "sourceLabel": "Hub",
          "why": "Guides you through quests step by step"
        },
        {
          "name": "Shortest Path",
          "source": "hub",
          "sourceLabel": "Hub",
          "why": "Draws the route to the point you picked on the map"
        },
        {
          "name": "Idle Notifier",
          "source": "builtin",
          "sourceLabel": "Built-in",
          "why": "Notifies you when your character is idle"
        },
