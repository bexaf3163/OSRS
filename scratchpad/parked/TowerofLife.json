        "nameEn": "Saw",
        "amount": 1,
        "wikiItemId": 8794,
        "howToGet": "Buy on the Grand Exchange, or from the Sawmill operator's shop for 13 gp.",
        "note": "Saw (or crystal saw)"
      },
      {
        "nameEn": "Beer",
        "amount": 1,
        "wikiItemId": 1917,
        "howToGet": "Buy on the Grand Exchange, or from a pub for 2 gp. 'The Guns' wants one.",
        "note": "Beer (must be a regular beer - other beers do not work.)"
      }
    ],
