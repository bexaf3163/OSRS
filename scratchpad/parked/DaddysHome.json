        "nameEn": "Plank",
        "amount": 10,
        "wikiItemId": 960,
        "howToGet": "Buy on the Grand Exchange. Oak, teak and mahogany planks do not work.",
        "note": "10 planks – (oak/teak/mahogany will not work)",
        "iconUrl": "https://oldschool.runescape.wiki/images/Plank.png"
      },
      {
        "nameEn": "Bolt of cloth",
        "amount": 5,
        "wikiItemId": 8790,
        "howToGet": "Buy on the Grand Exchange, or from the Sawmill operator north-east of Varrock for 650 coins each.",
        "note": "5 bolts of cloth (can be bought from the Sawmill for 650 coins per bolt)",
        "iconUrl": "https://oldschool.runescape.wiki/images/Bolt_of_cloth.png"
      },
      {
        "nameEn": "Steel nails",
        "amount": 100,
        "howToGet": "Buy on the Grand Exchange. Nails bend often at low Construction, so 100 covers level 1.",
        "wikiItemId": 1539,
        "iconUrl": "https://oldschool.runescape.wiki/images/Steel_nails.png"
      }
    ],
