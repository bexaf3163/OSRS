    ],
    "route": [
      {
        "title": "Walkthrough",
        "steps": [
          "Talk to Marlo in the Estate agent's house in north-east Varrock. Dialogue: \"What kind of favour do you want me to do?\", \"Tell me more about the job.\", \"Tell me where he lives, and I'll do the job.\"",
          "Talk to Old Man Yarlo in his house south-west of Aubury's Rune Shop.",
          "Remove all 7 old furnishings:",
          "Talk to Old Man Yarlo again. Dialogue: \"Skip Yarlo's lecture. He'll offer it later if you like.\"",
          "Search the crates marked with a black symbol, west of the range, for 3 waxwood logs.",
          "Go to the Varrock sawmill and talk to the Sawmill operator. Dialogue: \"I need some waxwood planks for Old Man Yarlo.\"",
          "Return to Old Man Yarlo's house and build the new furniture at every white, translucent hotspot.",
          "Talk to Old Man Yarlo after building all the furniture.",
          "Return to Marlo and claim the reward. Dialogue: \"Yeah, what have you got for me?\"",
          "Congratulations, miniquest complete!"
        ]
      }
    ],
