{
  "name": "osrs-put",
  "productName": "OSRS Path",
  "private": true,
  "version": "2.81.20",
  "description": "A personal progress tracker for Old School RuneScape (free version)",
  "author": "Mark",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --testTimeout=30000",
    "check-data": "node scripts/check-data.ts",
    "check-structure": "node scripts/check-structure.mjs --strict",
    "verify:quick": "node scripts/verify-quick.mjs",
    "bump": "node scripts/bump.mjs",
    "knip": "knip --include files,dependencies,unlisted",
    "dead-css": "node scripts/dead-css.mjs",
    "perf": "node scripts/perf.mjs",
    "pixeldiff": "node scripts/pixeldiff.mjs",
    "funding-coverage": "node scripts/funding-coverage-report.ts",
    "desktop": "npm run build && node scripts/build-bridge-jar.ts --optional && electron .",
    "dist:win": "npm run build && npm run bridge:jar && electron-builder --win portable --publish never",
    "build-items": "node scripts/build-items.ts",
    "build-locations": "node scripts/build-locations.ts",
    "build-transport-net": "node scripts/build-transport-net.ts",
    "build-gear": "node scripts/build-gear.ts",
    "build-money": "node scripts/build-money.ts",
    "build-threats": "node scripts/build-threats.ts",
    "build-combat-foes": "node scripts/build-combat-foes.ts",
    "build-ranged-gear": "node scripts/build-ranged-gear.ts",
    "build-style-gear": "node scripts/build-style-gear.ts",
    "check-links": "node scripts/check-links.ts",
    "bridge:jar": "node scripts/build-bridge-jar.ts",
    "test:ui": "node scripts/ui-smoke.ts",
    "test:e2e": "node scripts/e2e-electron.ts",
    "check-runelite": "node scripts/check-runelite-compat.ts",
    "telemetry": "node scripts/analyze-telemetry.ts",
    "build-weights": "node scripts/build-weights.ts",
    "build-portals": "node scripts/build-portals.ts",
    "build-trainers": "node scripts/build-trainers.ts",
    "build-skilling": "node scripts/build-skilling.ts",
    "build-processing": "node scripts/build-processing.ts"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "knip": "6.44.1",
    "leaflet": "^1.9.4",
    "pixelmatch": "5.3.0",
    "playwright": "^1.56.1",
    "pngjs": "7.0.0",
    "postcss": "8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "8.3.3",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "com.bexaf3163.osrsput",
    "productName": "OSRS Path",
    "copyright": "Mark",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon-512.png",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "OSRS-Put-${version}-portable.exe"
    },
    "extraResources": [
      {
        "from": "runelite-bridge/build/libs/osrs-path-bridge.jar",
        "to": "runelite-bridge/osrs-path-bridge.jar"
      }
    ]
  }
}
