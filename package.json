{
  "name": "osrs-put",
  "productName": "OSRS Путь",
  "private": true,
  "version": "2.22.0",
  "description": "Личный трекер прогресса в Old School RuneScape (бесплатная версия)",
  "author": "Mark",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --testTimeout=30000",
    "parse-guide": "node scripts/parse-guide.ts",
    "check-data": "node scripts/check-data.ts",
    "icons": "node scripts/make-icons.ts",
    "desktop": "npm run build && node scripts/build-bridge-jar.ts --optional && electron .",
    "dist:win": "npm run build && npm run bridge:jar && electron-builder --win portable --publish never",
    "build-items": "node scripts/build-items.ts",
    "build-locations": "node scripts/build-locations.ts",
    "build-gear": "node scripts/build-gear.ts",
    "build-money": "node scripts/build-money.ts",
    "build-threats": "node scripts/build-threats.ts",
    "build-style-gear": "node scripts/build-style-gear.ts",
    "check-links": "node scripts/check-links.ts",
    "bridge:jar": "node scripts/build-bridge-jar.ts",
    "test:ui": "node scripts/ui-smoke.ts",
    "test:e2e": "node scripts/e2e-electron.ts",
    "check-runelite": "node scripts/check-runelite-compat.ts",
    "build-weights": "node scripts/build-weights.ts"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "leaflet": "^1.9.4",
    "playwright": "^1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "com.bexaf3163.osrsput",
    "productName": "OSRS Путь",
    "copyright": "Mark",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon-512.png",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "OSRS-Put-${version}-portable.exe"
    },
    "extraResources": [
      {
        "from": "runelite-bridge/build/libs/osrs-path-bridge.jar",
        "to": "runelite-bridge/osrs-path-bridge.jar"
      }
    ]
  }
}
